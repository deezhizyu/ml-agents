# Git attributes for ML-Agents
# Ensures consistent line endings and proper file handling across platforms

# Auto detect text files and normalize line endings to LF
* text=auto

# Explicitly set text files to LF
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# PowerShell scripts use CRLF
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Unity files
*.cs text eol=crlf
*.meta text eol=crlf
*.unity text eol=crlf
*.prefab text eol=crlf
*.mat text eol=crlf
*.asset text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.onnx binary
*.pb binary
*.pt binary
*.pth binary
*.h5 binary
*.zip binary
*.tar binary
*.gz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Mark shell scripts as executable
*.sh linguist-language=Shell
setup-dev.sh linguist-language=Shell

