# ML-Agents Toolkit Environment Variables
#
# This file documents environment variables that can be used with ML-Agents.
# Copy this file to .env and customize as needed (never commit .env to git).

# ============================================================================
# Training Configuration
# ============================================================================

# Run ID for training sessions (optional - can be set via CLI)
# MLAGENTS_RUN_ID=my_training_run

# Training results directory (default: ./results)
# MLAGENTS_RESULTS_DIR=./results

# Base port for Unity environment communication (default: 5005)
# MLAGENTS_BASE_PORT=5005

# ============================================================================
# CI/CD and Testing
# ============================================================================

# Enforce strict buffer key type checking in tests (used in CI)
# TEST_ENFORCE_BUFFER_KEY_TYPES=1

# GitHub release tag verification (used in release workflow)
# GITHUB_REF=refs/tags/release_23

# ============================================================================
# HuggingFace Integration
# ============================================================================

# HuggingFace API token for pushing/pulling models
# Required for: mlagents-push-to-hf and mlagents-load-from-hf commands
# Get your token from: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HuggingFace repository ID (optional - can be set via CLI)
# HF_REPO_ID=username/model-name

# ============================================================================
# PyPI Publishing (for maintainers only)
# ============================================================================

# PyPI credentials (used in GitHub Actions release workflow)
# PYPI_PASSWORD=pypi-xxxxxxxxxxxxxxxxxxxxxxxxxx
# TEST_PYPI_PASSWORD=pypi-xxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Development Tools
# ============================================================================

# Python logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# MLAGENTS_LOG_LEVEL=INFO

# TensorBoard log directory (default: results/<run-id>)
# TENSORBOARD_LOG_DIR=./results

# ONNX export settings (for model conversion)
# ONNX_EXPORT_PATH=./models/exported.onnx

# ============================================================================
# GPU Configuration
# ============================================================================

# CUDA device selection for PyTorch (default: auto-detect)
# CUDA_VISIBLE_DEVICES=0

# Force CPU usage even if GPU available
# MLAGENTS_FORCE_CPU=false

# ============================================================================
# Unity Editor Integration
# ============================================================================

# Unity project path (optional)
# UNITY_PROJECT_PATH=./Project

# Unity executable path (for automated testing)
# UNITY_EXECUTABLE=/Applications/Unity/Hub/Editor/6000.0.0f1/Unity.app/Contents/MacOS/Unity

# ============================================================================
# Notes
# ============================================================================
#
# Most ML-Agents functionality works without environment variables.
# These are provided for advanced configuration and CI/CD workflows.
#
# For local development:
# 1. Copy this file: cp .env.example .env
# 2. Uncomment and set values as needed
# 3. Never commit .env to version control
#
# For production/CI:
# - Set sensitive values (API tokens, passwords) via CI secrets
# - Use GitHub Actions secrets for PYPI_PASSWORD, HF_TOKEN, etc.
